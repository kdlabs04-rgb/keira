            color: #444;
        }

        h2 {
            color: #7a3e9d;
            margin-top: 45px;
            margin-bottom: 25px;
        }

        /* =========================
           GALLERY
        ========================= */

        .gallery {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            width: 250px;
            background-color: white;
            border: 4px solid #7a3e9d;
            border-radius: 15px;
            padding: 10px;
            box-shadow: 0 5px 12px #c9b8d8;
        }

        .card label {
            cursor: pointer;
        }

        .card img {
            display: block;
            width: 230px;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
            margin: auto;
        }

        .card img:hover {
            opacity: 0.8;
        }

        .card h3 {
            color: #5b2c83;
            margin-bottom: 5px;
        }

        .card p {
            margin-top: 5px;
        }

        /* =========================
           HIDE CHECKBOXES
        ========================= */

        .popup-check {
            display: none;
        }

        /* =========================
           POPUP BACKGROUND
        ========================= */

        .popup {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.75);
            padding: 30px;
            overflow-y: auto;
        }

        /* SHOW POPUP WHEN CHECKED */

        #poem:checked ~ #poemPopup,
        #essay:checked ~ #essayPopup,
        #story:checked ~ #storyPopup,
        #tula:checked ~ #tulaPopup,
        #sanaysay:checked ~ #sanaysayPopup {
            display: block;
        }

        /* =========================
           POPUP BOX
        ========================= */

        .popup-box {
            background-color: white;
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 40px black;
            position: relative;
        }

        /* =========================
           CLOSE BUTTON
        ========================= */

        .close {
            position: absolute;
            right: 20px;
            top: 10px;
            font-size: 40px;
            font-weight: bold;
            color: #7a3e9d;
            cursor: pointer;
            z-index: 5;
        }

        .close:hover {
            color: red;
        }

        /* =========================
           POPUP TITLE
        ========================= */

        .popup-title {
            color: #5b2c83;
            text-align: center;
            font-size: 30px;
            margin-top: 5px;
            margin-bottom: 25px;
        }

        /* =========================
           TEXT + PICTURE BESIDE EACH OTHER
        ========================= */

        .composition {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            gap: 30px;
            text-align: left;
        }

        .composition-text {
            width: 58%;
            line-height: 1.6;
            font-size: 16px;
        }

        .composition-picture {
            width: 42%;
            text-align: center;
            position: sticky;
            top: 20px;
        }

        .composition-picture img {
            width: 100%;
            max-width: 400px;
            height: 400px;
            object-fit: cover;
            border-radius: 15px;
            border: 4px solid #7a3e9d;
        }

        /* STORY HEADINGS */

        .composition-text h3 {
            color: #7a3e9d;
            margin-top: 25px;
        }

        /* =========================
           MOBILE
        ========================= */

        @media screen and (max-width: 800px) {

            .composition {
                flex-direction: column;
            }

            .composition-text,
            .composition-picture {
                width: 100%;
            }

            .composition-picture {
                position: static;
                order: -1;
            }

            .composition-picture img {
                height: 300px;
            }

            .popup {
                padding: 10px;
            }

            .popup-box {
                width: 96%;
                padding: 20px;
            }

        }

    </style>

</head>


