    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background-color: #f3eaff;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h1 {
            color: #5b2c83;
